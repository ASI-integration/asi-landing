# Non-secret source for asi-p1-686-one-shot.service.
# Secret values stay in their existing protected files and are not copied here.
ASI_WORKER_SLOT=5
ASI_AUTOMATIC_RETRY=false
ASI_API_FALLBACK=false
ASI_MODEL_EFFECTS=CODEX,INDEPENDENT_REVIEW
ASI_DISPATCHER_EXECUTE=NO
ASI_PAID_CALLS_ENABLED=NO
ASI_GLOBAL_CAP_KOPECKS=0
