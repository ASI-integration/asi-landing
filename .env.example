# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session (min 32 chars for iron-session)
SESSION_SECRET=your-session-secret-at-least-32-characters-long

# YooKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# LLM Provider — primary (any OpenAI-compatible API)
# Set LLM_BASE_URL to swap providers without code changes.
# Examples:
#   OpenAI:      https://api.openai.com/v1  (default)
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   Together AI: https://api.together.xyz/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=10000

# LLM Provider — fallback (optional, tried if primary fails)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Legacy — still accepted if LLM_API_KEY is not set
OPENAI_API_KEY=your-openai-api-key


# App URL (for payment return)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Cron (optional, for /api/cron/check-trial)
CRON_SECRET=your-cron-secret

# DaData Suggestions API (for public location intelligence address autocomplete)
# Get a free key at https://dadata.ru — server-side only, never exposed to browser
# Without this key the address suggest endpoint returns empty results gracefully.
DADATA_API_KEY=your-dadata-api-key
