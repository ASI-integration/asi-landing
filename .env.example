# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session (min 32 chars for iron-session)
SESSION_SECRET=your-session-secret-at-least-32-characters-long

# YooKassa
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
# Production asi-backend: Google VM relay to api.telegram.org (see scalable-fastapi-backend Docs/telegram-mvp-freeze.md)
TELEGRAM_API_BASE_URL=http://34.42.241.227:8088
# Synthetic Telegram tests: never use real guest/owner chat unless ALLOW_REAL_TELEGRAM_SYNTHETIC=1
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_PROTECTED_CHAT_IDS=931919812
DRY_RUN_TELEGRAM_OUTBOUND=false
ALLOW_REAL_TELEGRAM_SYNTHETIC=false
# asi-backend policy LLM enrich (after deterministic guest agent)
LLM_ENABLED=false
LLM_PROVIDER=openai
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-optional
# Telegram voice inbound (file fetch safety)
TELEGRAM_FILE_TIMEOUT_MS=20000
TELEGRAM_VOICE_MAX_BYTES=20971520
TELEGRAM_VOICE_FETCH_RETRIES=2

# WhatsApp Cloud API (Voice inbound + text fallback outbound)
# Webhook verify step (Meta Webhooks):
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# Optional but recommended: verify incoming POST signature (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your-meta-app-secret
# Cloud API access token (used for media fetch and outbound send)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# Cloud API phone number id (used for outbound send)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Optional Graph config
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# Safety controls
WHATSAPP_HTTP_TIMEOUT_MS=20000
WHATSAPP_MEDIA_MAX_BYTES=20971520

# Voice STT (OpenAI Whisper / Google VM relay)
VOICE_TRANSCRIPTION_DISABLED=0
WHISPER_TIMEOUT_MS=30000
# asi-backend (Timeweb): STT через Google VM relay (OpenAI-compatible), не напрямую в api.openai.com
VOICE_STT_BASE_URL=http://34.42.241.227:8090/v1
VOICE_STT_MODEL=gpt-4o-transcribe
VOICE_STT_RELAY_TOKEN=
# text | voice | both | mirror (voice in → voice out when mirror)
VOICE_REPLY_MODE=mirror
VOICE_REPLY_ENABLED=0
VOICE_REPLY_MAX_CHARS=300
# openai (default) | elevenlabs
VOICE_TTS_PROVIDER=openai
# Voice reply budget caps (optional)
VOICE_DAILY_REPLY_LIMIT_PER_CHAT=30
VOICE_DAILY_SECONDS_LIMIT_PER_CHAT=900
VOICE_MONTHLY_SECONDS_LIMIT_GLOBAL=36000
VOICE_TTS_BASE_URL=
VOICE_TTS_RELAY_TOKEN=
VOICE_TTS_API_KEY=
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=coral
VOICE_TTS_RESPONSE_FORMAT=opus
# gpt-4o-mini-tts only: 0.25–4.0 (invalid → 1.0)
VOICE_TTS_SPEED=1.08
VOICE_TTS_INSTRUCTIONS=Говори на русском языке с нейтральным русским произношением, без английского или американского акцента. Голос спокойный, дружелюбный, как администратор апартаментов. Не растягивай слова.
OPENAI_BASE_URL=https://api.openai.com/v1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VOICE_STT_ENABLED=true

# VK (OAuth)
# Create a VK app and set its redirect/callback URL to:
#   https://asi-global.ru/api/connect/vk/callback
# These values must be SERVER-ONLY (do not prefix with NEXT_PUBLIC_*)
VK_CLIENT_ID=your-vk-client-id
VK_CLIENT_SECRET=your-vk-client-secret

# VK community messaging transport (Callback API + messages.send)
VK_GROUP_ID=
VK_API_TOKEN=
VK_CALLBACK_SECRET=
VK_CONFIRMATION_CODE=
VK_API_VERSION=5.199

# MAX messenger transport (Webhook + POST /messages)
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api.max.ru

# Phone support Phase 1 (telephony webhook intake; placeholders only)
PHONE_PROVIDER=
PHONE_WEBHOOK_SECRET=
PHONE_SUPPORT_NUMBER=
PHONE_OPERATOR_FORWARD_NUMBER=
PHONE_RECORDING_ENABLED=false
PHONE_TRANSCRIPTION_ENABLED=false

# LLM Provider — primary (any OpenAI-compatible API)
# Set LLM_BASE_URL to swap providers without code changes.
# Examples:
#   OpenAI:      https://api.openai.com/v1  (default)
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   Together AI: https://api.together.xyz/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=10000

# Telegram guest LLM router fallback
# Canon/rules stay first. Router is used only for low-confidence, unknown, or complex Telegram guest messages.
# off | shadow | assist | controlled_override | primary. Use shadow for dry-run audit only.
TELEGRAM_GUEST_AGENT_MODE=off
LLM_ROUTER_PROVIDER=disabled
LLM_ROUTER_MODE=fixed
LLM_ROUTER_PRIMARY_PROVIDER=deepseek
LLM_ROUTER_SECONDARY_PROVIDER=openai
LLM_ROUTER_TERTIARY_PROVIDER=openai-premium
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_PREMIUM_MODEL=gpt-5-mini
LLM_ROUTER_TIMEOUT_MS=6000
LLM_ROUTER_MAX_RETRIES=1
LLM_ROUTER_PRIMARY_TIMEOUT_MS=5000
LLM_ROUTER_SECONDARY_TIMEOUT_MS=6000
LLM_ROUTER_MAX_PROVIDER_ATTEMPTS=2
LLM_ROUTER_STICKY_PROVIDER_TTL_MINUTES=15
LLM_ROUTER_AUTO_FALLBACK_ENABLED=true

# Telegram guest semantic router (intent/topic classification, no guest reply text)
# Used before reply LLM router to disambiguate Wi-Fi access vs problem, waste vs cleaning, etc.
TELEGRAM_SEMANTIC_ROUTER_ENABLED=false
TELEGRAM_SEMANTIC_ROUTER_PROVIDER=openai
TELEGRAM_SEMANTIC_ROUTER_MODEL=
TELEGRAM_SEMANTIC_ROUTER_TIMEOUT_MS=5000

# LLM Provider — fallback (optional, tried if primary fails)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Legacy — still accepted if LLM_API_KEY is not set
OPENAI_API_KEY=your-openai-api-key


# App URL (for payment return)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Public support email (mailto, legal pages). Embedded at build time.
NEXT_PUBLIC_CONTACT_EMAIL=support@asi-global.ru

# Guest communication email transport (placeholders only; do not commit secrets)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
# Email guest communication MVP — draft-only by default (no auto-send to guests)
EMAIL_AUTO_SEND=false
EMAIL_DRAFT_ONLY=true

# Cron (optional, for /api/cron/check-trial)
CRON_SECRET=your-cron-secret

# ASI Runtime snapshot ingest (server-to-server only; POST /api/internal/asi-runtime/snapshot)
ASI_RUNTIME_INGEST_TOKEN=your-runtime-ingest-token
ASI_RUNTIME_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# ASI Chat Runtime Bridge — isolated Supabase project (server-only; never NEXT_PUBLIC_*)
# Distinct from primary SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY used for auth, CRM, and app data.
# Ready only when CLIENT_ID + Bridge URL + Bridge service-role key are all set.
ASI_RUNTIME_BRIDGE_CLIENT_ID=
ASI_RUNTIME_BRIDGE_SUPABASE_URL=
ASI_RUNTIME_BRIDGE_SUPABASE_SERVICE_ROLE_KEY=
# Bearer tokens (each ≥32 chars, pairwise distinct) — see docs/asi-chat-runtime-bridge-v1.md
# ASI_RUNTIME_BRIDGE_CHAT_TOKEN=
# ASI_RUNTIME_BRIDGE_OWNER_TOKEN=
# ASI_RUNTIME_BRIDGE_RUNNER_TOKEN=

# CRM operator access (/dashboard/crm, /dashboard/crm/queue). Comma-separated allowlist.
# OPERATOR_EMAIL is also honored as a single operator address.
CRM_OPERATOR_EMAILS=project.ayfaar@gmail.com

# OPS admin access (manual task creation on /dashboard/ops). Comma-separated allowlist.
OPS_ADMIN_EMAILS=project.ayfaar@gmail.com

# ASI Owner Development Console (/dashboard/development). Comma-separated allowlist.
# Production denies all access when empty. No CRM / @asi-global.ru fallback.
# Do not put real production owner emails into committed examples.
ASI_DEVELOPMENT_OWNER_EMAILS=

# Google OAuth (Login)
# Create an OAuth 2.0 Client ID of type "Web application".
# IMPORTANT: NEXT_PUBLIC_* values are embedded at build time (next build).
# Keep GOOGLE_CLIENT_ID equal to NEXT_PUBLIC_GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps — Places Autocomplete + Geocoding + Place Details (server-side /api/address-*)
# RU and EN use the same Google-backed suggest/geocode flow (language/region bias for RU).
# Create a key in Google Cloud Console. Enable: Places API, Geocoding API, Place Details (if used).
# For server-side routes, use a key restricted by IP (Vercel egress) or unrestricted — NOT HTTP referrer-only.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional fallback if GOOGLE_MAPS_SERVER_API_KEY is unset (embedded at build time).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 2GIS Catalog (optional — not used for /api/address-*; map embed / legacy only)
TWOGIS_CATALOG_API_KEY=

# DaData Suggestions API (optional RU fallback after Google / Photon in /api/address-suggest)
# Get a free key at https://dadata.ru — server-side only
DADATA_API_KEY=your-dadata-api-key

# 2GIS MapGL JS API (for location-analysis environment map)
# Get a key at https://dev.2gis.ru — public client-side key, safe to expose.
# Without this key the map falls back to 2GIS iframe embed (real 2GIS tiles, no key required).
NEXT_PUBLIC_TWOGIS_API_KEY=

# ─── ASI-automation-core integration ──────────────────────────────────────────
# asi-landing is a thin UI layer. All operator data (leads, status updates,
# notes, follow-ups) and location analysis route through ASI-automation-core.
# No direct Supabase access for operator domain data in asi-landing.
#
# ASI_CORE_BASE_URL   — base URL of the running ASI-automation-core service
#                       (no trailing slash)
#                       Local dev:  http://localhost:3001
#                       Staging:    https://asi-core-staging.vercel.app
#                       Production: https://asi-core.yourdomain.com
#
# ASI_CORE_API_SECRET — shared secret for server-to-server auth.
#                       asi-landing sends: Authorization: Bearer <secret>
#                       ASI-automation-core must validate this header on all
#                       /api/operator/* and /api/location-analyze routes.
#                       Generate with: openssl rand -hex 32
ASI_CORE_BASE_URL=http://localhost:3001
ASI_CORE_API_SECRET=your-shared-secret-min-32-chars

# Location intelligence — Korzun pipeline diagnostics (verbose JSON + soft asserts in server logs). Default: off.
LOCATION_KORZUN_DIAGNOSTICS_ENABLED=false

# Location intelligence — public procurement live probe (ЕИС). Default: off, sample-cache only; no outbound HTTP.
PUBLIC_PROCUREMENT_LIVE_PROBE_ENABLED=false

# ЕИС official machine-access skeleton (ПМД-style credentials). Default: off; no production HTTP wiring.
EIS_OFFICIAL_CONNECTOR_ENABLED=false
EIS_PMD_TOKEN=
EIS_SERVICE_BASE_URL=
EIS_REQUEST_MODE=TEST
EIS_ORGANIZATION_INN=
EIS_ORGANIZATION_KPP=
