{
  "schemaVersion": "asi.agent-os.change-to-test-map.v1",
  "default": {
    "checks": ["touched-file-eslint", "typecheck", "focused-test", "git-diff-check", "exact-diff-review"],
    "focusedTestLimit": { "files": 2, "tests": 30 }
  },
  "rules": [
    {
      "id": "agent-os-contracts",
      "prefixes": [
        "docs/agent-os/",
        ".agents/skills/asi-task-execution/",
        ".agents/skills/asi-staging-acceptance/",
        ".agents/skills/asi-production-rollout/",
        "scripts/agent-os/"
      ],
      "checks": ["agent-os-contract-validation", "release-manifest-check", "skill-quick-validate", "skill-structure-validation", "skill-forward-test", "focused-contract-test", "git-diff-check"],
      "protected": false
    },
    {
      "id": "github-templates",
      "prefixes": [".github/ISSUE_TEMPLATE/", ".github/PULL_REQUEST_TEMPLATE.md"],
      "checks": ["yaml-or-markdown-parse", "local-link-check", "git-diff-check"],
      "protected": false
    },
    {
      "id": "location-protected",
      "prefixes": ["src/lib/location/"],
      "checks": ["consumer-search", "focused-location-test", "typecheck", "touched-file-eslint"],
      "protected": true,
      "redActions": ["location_scoring_or_public_contract_change"],
      "notes": "Scoring, SSOT and public contracts require explicit red approval; do not run test:location-golden unless AGENTS.md permits it."
    },
    {
      "id": "booking-lifecycle",
      "prefixes": ["src/lib/booking-lifecycle", "src/app/api/booking", "src/app/api/cron/booking"],
      "checks": ["exact-task-identity-review", "focused-lifecycle-test", "typecheck", "touched-file-eslint"],
      "protected": false
    },
    {
      "id": "migration",
      "prefixes": ["supabase/migrations/"],
      "checks": ["destructive-sql-review", "migration-dependency-order-test", "migration-process-contract", "git-diff-check"],
      "protected": true,
      "notes": "Creating a migration can be yellow; applying it to any database requires docs/agent-os/MIGRATION_PROCESS.md and the applicable gate."
    },
    {
      "id": "migration-process",
      "prefixes": [
        "docs/agent-os/MIGRATION_PROCESS.md",
        "docs/agent-os/migration-mechanisms.json",
        "docs/agent-os/schemas/migration-",
        "scripts/agent-os/migration-process.mjs",
        "scripts/agent-os/check-migration-process.mjs",
        "scripts/apply-",
        ".github/workflows/apply-",
        ".github/workflows/partner-production-rollout-control-v1.yml",
        "scripts/staging-booking-ops-schema-smoke.sh"
      ],
      "checks": ["migration-process-contract", "agent-os-contract-validation", "focused-contract-test", "git-diff-check"],
      "protected": true,
      "redActions": ["production_migration"],
      "notes": "Unify behind the shared migration contract; do not invent a second framework or apply DDL from CI."
    },
    {
      "id": "staging-scripts",
      "prefixes": ["scripts/deploy-artifact-staging", "scripts/rollback-artifact-staging", "scripts/staging-"],
      "checks": ["shell-or-node-syntax", "fail-closed-guard", "staging-identity-review", "migration-count-doc-check", "migration-process-contract", "git-diff-check"],
      "protected": true,
      "notes": "Do not execute against an external staging target unless every v0 blocker prerequisite is closed."
    },
    {
      "id": "staging-bootstrap-runbook",
      "prefixes": ["docs/BOOKING_OPS_STAGING_BOOTSTRAP.md"],
      "checks": ["migration-count-doc-check", "local-link-check", "git-diff-check"],
      "protected": false,
      "notes": "Runbook must not hard-code migration counts; CI derives them from supabase/migrations/."
    },
    {
      "id": "production-operations",
      "prefixes": [".github/workflows/deploy.yml", "scripts/deploy-artifact.sh", "scripts/rollback-artifact.sh"],
      "checks": ["read-only-workflow-review", "owner-gate-review", "git-diff-check"],
      "protected": true,
      "redActions": ["production_deploy", "production_rollback"]
    }
  ]
}
