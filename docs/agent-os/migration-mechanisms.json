{
  "schemaVersion": "asi.agent-os.migration-mechanism-registry.v1",
  "canonicalRunbook": "docs/agent-os/MIGRATION_PROCESS.md",
  "discovery": {
    "sqlChainDir": "supabase/migrations",
    "helperGlob": "scripts/apply-*migration*",
    "workflowGlobs": [
      ".github/workflows/apply-*.yml",
      ".github/workflows/partner-production-rollout-control-v1.yml"
    ],
    "stagingSmoke": "scripts/staging-booking-ops-schema-smoke.sh"
  },
  "mechanisms": [
    {
      "id": "supabase-migrations-chain",
      "kind": "sql-chain",
      "role": "source-of-truth",
      "paths": ["supabase/migrations"],
      "environments": ["local", "staging", "production"],
      "ownerGateRequired": false,
      "supportsDryRun": true,
      "rollbackPolicy": "append-only-forward-fix",
      "notes": "Canonical ordered SQL history. Creating files is yellow; applying to any database is red/owner-gated per environment."
    },
    {
      "id": "supabase-cli-staging-push",
      "kind": "cli-push",
      "role": "apply-backend",
      "paths": [
        "docs/BOOKING_OPS_STAGING_BOOTSTRAP.md",
        "scripts/staging-booking-ops-schema-smoke.sh"
      ],
      "environments": ["staging"],
      "ownerGateRequired": true,
      "supportsDryRun": true,
      "rollbackPolicy": "owner-gated-new-migration",
      "notes": "Existing staging operator path: identity-checked supabase db push --dry-run then owner-approved push. Count drift is tracked separately by AO-005."
    },
    {
      "id": "partner-production-rollout",
      "kind": "controlled-rollout",
      "role": "apply-backend",
      "paths": [
        "docs/operations/partner-production-rollout-v1/README.md",
        "docs/operations/partner-production-rollout-v1/manifest.json",
        ".github/workflows/partner-production-rollout-control-v1.yml"
      ],
      "environments": ["production"],
      "ownerGateRequired": true,
      "supportsDryRun": true,
      "rollbackPolicy": "atomic-transaction",
      "migrationPaths": [
        "supabase/migrations/20260816144742_partner_property_knowledge_schema_completion_v1.sql",
        "supabase/migrations/20260815102111_partner_communication_durable_state_v1.sql",
        "supabase/migrations/20260815130000_partner_authenticated_inbox_v1.sql",
        "supabase/migrations/20260815160000_partner_communication_brain_v1.sql",
        "supabase/migrations/20260815190000_partner_service_recovery_loop_v1.sql",
        "supabase/migrations/20260815210000_partner_review_reputation_engine_v1.sql",
        "supabase/migrations/20260815230000_partner_revenue_shadow_pricing_v1.sql"
      ],
      "notes": "Checksum-pinned seven-file production rollout with preflight/apply split and atomic psql transaction."
    },
    {
      "id": "workflow-booking-lifecycle",
      "kind": "github-workflow",
      "role": "apply-backend",
      "paths": [
        ".github/workflows/apply-booking-lifecycle-migration.yml",
        "scripts/apply-booking-lifecycle-migration-remote.py"
      ],
      "environments": ["production"],
      "ownerGateRequired": true,
      "supportsDryRun": false,
      "rollbackPolicy": "owner-gated-new-migration",
      "migrationPaths": ["supabase/migrations/20260630000001_booking_lifecycle_gates_v1.sql"],
      "notes": "Typed-confirmation production workflow; phrase is not owner approval."
    },
    {
      "id": "workflow-booking-legal-payment",
      "kind": "github-workflow",
      "role": "apply-backend",
      "paths": [
        ".github/workflows/apply-booking-legal-payment-migration.yml",
        "scripts/apply-booking-legal-payment-migration-remote.py"
      ],
      "environments": ["production"],
      "ownerGateRequired": true,
      "supportsDryRun": false,
      "rollbackPolicy": "owner-gated-new-migration",
      "migrationPaths": ["supabase/migrations/20260629235959_booking_legal_payment_autopilot_v1.sql"],
      "notes": "Typed-confirmation production workflow for legal/payment autopilot DDL. Workflow YAML still names a historical filename; registry pins the existing SQL chain file."
    },
    {
      "id": "workflow-booking-instay-checkout",
