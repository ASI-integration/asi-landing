{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asi.local/agent-os/release-manifest.schema.json",
  "title": "ASI Agent OS release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "sourceBranch",
    "baselineSha",
    "generatedAt",
    "package",
    "migrations",
    "activeGates"
  ],
  "properties": {
    "schemaVersion": { "const": "asi.agent-os.release-manifest.v1" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sourceBranch": { "type": "string", "minLength": 1 },
    "baselineSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "count"],
      "properties": {
        "directory": { "const": "supabase/migrations" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "activeGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workflow"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "workflow": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.yml$" }
        }
      }
    }
  }
}
