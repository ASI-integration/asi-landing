{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asi.local/agent-os/migration-plan.schema.json",
  "title": "ASI Agent OS migration plan",
  "description": "Machine-readable plan for a migration dry-run or apply handoff. Declares target identity, selected mechanism, migration files, apply gate, verification, and rollback policy without performing DDL.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "mechanismId",
    "target",
    "migrations",
    "applyGate",
    "verification",
    "rollback",
    "mutationAllowed",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "asi.agent-os.migration-plan.v1" },
    "mode": { "enum": ["plan", "dry-run", "apply"] },
    "mechanismId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "identity", "expectedIdentity"],
      "properties": {
        "environment": { "enum": ["local", "staging", "production"] },
        "identity": { "type": "string", "minLength": 1 },
        "expectedIdentity": { "type": "string", "minLength": 1 }
      }
    },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "version"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "applyGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "ownerGateAction", "status"],
      "properties": {
        "required": { "type": "boolean" },
        "ownerGateAction": {
          "enum": ["production_migration", "not_required", "staging_operator_approval"]
        },
        "status": { "enum": ["not_required", "missing", "satisfied", "blocked"] },
        "confirmationPhrase": { "type": ["string", "null"], "minLength": 1 },
        "establishedApplyPath": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "strategy"],
      "properties": {
        "policy": { "enum": ["append-only-forward-fix", "atomic-transaction", "owner-gated-new-migration"] },
        "strategy": { "type": "string", "minLength": 1 }
      }
    },
    "mutationAllowed": { "type": "boolean" },
    "generatedAt": { "type": "string", "format": "date-time" }
  }
}
