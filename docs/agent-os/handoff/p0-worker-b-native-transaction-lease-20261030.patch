+      await fs.rm(root,{recursive:true,force:true});}
+  });
+  test('native admission, preflight, started write, postflight share one durable journal',async()=>{
+    const phaseRoot=root+'-phases';
+    await fs.mkdir(phaseRoot,{mode:0o700});
