+
+test('non-writable or non-extensible ledger budget root never fsyncs an orphan claim',async()=>{
+  for(const variant of ['readonly-own','nonextensible-absent']){
+    const f=await fixture();try{
+      if(variant==='readonly-own'){
+        Object.defineProperty(f.ledger,'standingDelegationBudget',{
+          value:{version:1,envelopes:{}},writable:false,configurable:true,enumerable:true
+        });
+      }else Object.preventExtensions(f.ledger);
+      let thrown;
+      try{await f.budget.reserve({envelope:env(),effect:effect('root-'+variant)})}
+      catch(e){thrown=e}
+      const persisted=await f.read();
+      assert.equal(Object.hasOwn(persisted,'standingDelegationBudget'),false,
+        variant+' orphan claim written before in-memory commit');
+      assert.match(String(thrown?.message),/BUDGET_LEDGER_INVALID/,variant);
+    }finally{await f.close()}
+  }
+});
+
