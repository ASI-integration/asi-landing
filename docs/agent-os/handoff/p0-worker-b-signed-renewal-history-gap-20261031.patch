diff --git a/scripts/strigunov4/execution-adapters/standing-budget-signed-renewal-gap.test.mjs b/scripts/strigunov4/execution-adapters/standing-budget-signed-renewal-gap.test.mjs
new file mode 100644
index 00000000..751e43ed
--- /dev/null
+++ b/scripts/strigunov4/execution-adapters/standing-budget-signed-renewal-gap.test.mjs
@@ -0,0 +1,105 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import {createHash,generateKeyPairSync,sign} from 'node:crypto';
+import {initializeState,inspectStandingTransaction} from './state.mjs';
+import {createStandingPublisherBudget} from './standing-budget.mjs';
+import {inspectParentCandidateInNativeTransaction,inspectSignedParentInNativeTransaction} from './standing-parent-native-preview.mjs';
+import {inspectSignedParentChildSource} from './standing-parent-signature-source.mjs';
+import {assessParentBudgetProposal} from './standing-parent-budget-proposal.mjs';
+
+const sha=x=>createHash('sha256').update(x).digest('hex');
+const D=86400000, N=1793400000000, FIRST=N-2*D, SHA40='a'.repeat(40);
+const owner=generateKeyPairSync('ed25519'),verifier=generateKeyPairSync('ed25519');
+const publicPem=k=>k.publicKey.export({type:'spki',format:'pem'});
+const fingerprint=k=>sha(k.publicKey.export({type:'spki',format:'der'}));
+const signed=(v,k)=>{const payload=JSON.stringify(v);return {payload,signature:sign(null,Buffer.from(payload),k.privateKey).toString('base64')};};
+const parentBody={schema:'asi.standing-parent.proposal.v1',repo:'ASI-integration/asi-landing',
+ environment:'beget-staging',target:'pqukibofpo',action:'source',stage:'S4-G2',baseSha:SHA40,
+ approvedRoutineClasses:['stage4-source-maintenance'],securityDigest:sha('security'),
+ policyDigest:sha('policy'),notBefore:N-10*D,expiresAt:N+300*D,
+ paidApiUsd:0,maxOperations:256,maxRequests:256,maxWrites:64};
+const signedParent=signed(parentBody,owner),parentDigest=sha(signedParent.payload);
+function child(start,end) {
+ const payload={...parentBody,schema:'asi.standing-child.proposal.v1',parentDigest,
+   notBefore:start,expiresAt:end,maxOperations:2,maxRequests:2,maxWrites:1};
+ const wrapped=signed(payload,verifier);
+ return {wrapped,digest:sha(wrapped.payload),payload};
+}
+const old=child(N-3*D,N-D),current=child(N-D,N+2*D);
+const ownerPublicKey=publicPem(owner),verifierPublicKey=publicPem(verifier);
+const expected={baseSha:SHA40,securityDigest:parentBody.securityDigest,
+ policyDigest:parentBody.policyDigest,ownerKeySha256:fingerprint(owner),
+ verifierKeySha256:fingerprint(verifier)};
+const proof=(c,now)=>inspectSignedParentChildSource({signedParent,signedChild:c.wrapped,
+ ownerPublicKey,verifierPublicKey,expected,now});
+const task=id=>({id,sha:SHA40,repo:parentBody.repo,stage:'S4-G2',pr:null,branch:'source-only/'+id});
+function effect(id,taskId,digest) {
+ const method='GET',route='pulls/552',payloadSha256=sha('');
+ return {effectId:id,taskId,taskSha:SHA40,headSha:SHA40,kind:'github-read',
+  method,route,payloadSha256,requestSha256:sha(JSON.stringify({method,route,payloadSha256})),
+  envelopeDigest:digest,repo:parentBody.repo,environment:parentBody.environment,
+  target:parentBody.target,action:parentBody.action};
+}
+test('real durable old-child reservation exposes signed-renewal history bridge gap',async()=>{
+ const root=await fs.mkdtemp(path.join(os.tmpdir(),'p0wb-renewal-source-'));
+ try {
+  const store=await initializeState(root);
+  const oldProof=proof(old,FIRST),newProof=proof(current,N);
+  assert.equal(oldProof.status,'SIGNED_PARENT_CHILD_SOURCE_VERIFIED');
+  assert.equal(newProof.status,'SIGNED_PARENT_CHILD_SOURCE_VERIFIED');
+  const expiredHistoricalSource=proof(old,N);
+  assert.equal(expiredHistoricalSource.status,'SIGNED_PARENT_CHILD_SOURCE_BLOCKED');
+  assert.equal(expiredHistoricalSource.reason,'SOURCE_PARENT_CHILD_SCOPE');
+  const oldEnvelope={schema:'asi.release-envelope.proposal.v1',repo:parentBody.repo,
+   environment:parentBody.environment,target:parentBody.target,action:parentBody.action,
+   envelopeDigest:old.digest,securityDigest:parentBody.securityDigest,
+   policyDigest:parentBody.policyDigest,notBefore:old.payload.notBefore,
+   expiresAt:old.payload.expiresAt,paidApiUsd:0,maxOperations:2,maxRequests:2,maxWrites:1};
+  const first=await store.execute('github-publisher',task('first-child'),
+   {async verifyTask(){return {sourceOnly:true};}},async({transaction})=>{
+    const ledger=inspectStandingTransaction(transaction).ledger;
+    const budget=createStandingPublisherBudget({store,ledger,transaction,clock:()=>FIRST});
+    const reserved=await budget.reserve({envelope:oldEnvelope,effect:effect('old-read','first-child',old.digest)});
+    assert.equal(reserved.status,'RESERVED',JSON.stringify(reserved));
+    return {status:'WAITING',reason:'NO_PROVIDER_CALL'};
+   });
+  assert.equal(first.mode,'WAITING');
+  const disk=JSON.parse(await fs.readFile(store.file('autopilot-ledger.json'),'utf8'));
+  assert.equal(disk.standingDelegationBudget.envelopes[old.digest].claims.length,1);
+  let observed=0;
+  const second=await store.execute('github-publisher',task('second-child'),
+   {async verifyTask(t,{transaction}) {
+     const active=inspectStandingTransaction(transaction);
+     const e=effect('new-read','second-child',current.digest);
+     const signedResult=inspectSignedParentInNativeTransaction({store,transaction,
+      effect:e,now:N,signedParent,signedChild:current.wrapped,ownerPublicKey,
+      verifierPublicKey,expected,revokedParentDigests:[],revokedChildDigests:[]});
+     const bothLinks=inspectParentCandidateInNativeTransaction({store,transaction,
+      parent:newProof.parent,child:newProof.child,
+      childLinks:{[old.digest]:oldProof.childLink,[current.digest]:newProof.childLink},
+      effect:e,now:N,revokedParentDigests:[]});
+     const raw=assessParentBudgetProposal({parent:newProof.parent,child:newProof.child,
+       childLinks:{[old.digest]:oldProof.childLink,[current.digest]:newProof.childLink},
+       ledger:active.ledger,effect:e,now:N,revokedParentDigests:[]});
+     assert.equal(raw.status,'PARENT_BUDGET_SOURCE_ELIGIBLE');
+     assert.equal(signedResult.status,'PARENT_NATIVE_PREVIEW_BLOCKED');
+     assert.equal(signedResult.reason,'NATIVE_SIGNED_SOURCE_NOT_BOUND');
+     assert.equal(bothLinks.status,'PARENT_NATIVE_SOURCE_ELIGIBLE',JSON.stringify(bothLinks));
+     assert.equal(bothLinks.authorized,false);
+     observed++;
+     return {sourceOnly:true};
+   }},async()=>({status:'WAITING',reason:'NO_PROVIDER_CALL'}));
+  assert.equal(second.mode,'WAITING');
+  assert.equal(observed,2);
+  const after=JSON.parse(await fs.readFile(store.file('autopilot-ledger.json'),'utf8'));
+  assert.equal(after.standingDelegationBudget.envelopes[old.digest].claims.length,1);
+  console.log('P0WB_VERIFIED_HISTORY_GAP='+JSON.stringify({
+   historicalDurableClaims:1,historicalChildExpiredAtSecondRun:true,
+   currentSignedChildValid:true,signedBridge:'BLOCKED',
+   sourceWithBothHistoricalLinks:'SOURCE_ELIGIBLE_NOT_AUTHORIZED',
+   externalEffects:0}));
+ } finally {await fs.rm(root,{recursive:true,force:true});}
+});
