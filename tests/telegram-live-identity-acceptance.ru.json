{
  "reset_command": "/reset_identity",
  "reset_expected_reply": "Идентичность и сессия сброшены для acceptance-тестирования.",
  "cases": [
    {
      "name": "unknown_greeting_ru",
      "input": "здравствуйте",
      "assertions": {
        "should_include_any": ["Здравствуйте! Я помощник ASI", "с чем вы обращаетесь"],
        "must_not_include_any": ["заселение, доступ, бронь, уборка или поломка"]
      }
    },
    {
      "name": "unknown_greeting_en",
      "input": "hi",
      "assertions": {
        "should_include_any": ["Здравствуйте! Я помощник ASI", "с чем вы обращаетесь"],
        "must_not_include_any": ["заселение, доступ, бронь, уборка или поломка"]
      }
    },
    {
      "name": "self_declared_guest",
      "input": "Я гость",
      "assertions": {
        "should_include_any": ["Поняла, вы гость", "заселение", "Wi-Fi"],
        "must_not_include_any": ["вы гость по бронированию", "владелец/управляющий", "подключение ASI"]
      }
    },
    {
      "name": "lead_intent",
      "input": "Хочу подключить ASI",
      "assertions": {
        "should_include_any": ["Спасибо за интерес к ASI", "город", "пилота"]
      }
    },
    {
      "name": "self_declared_owner",
      "input": "Я владелец/управляющий",
      "assertions": {
        "should_include_any": ["Поняла, вы владелец/управляющий", "внутреннее обращение"],
        "must_not_include_any": ["не буду отвечать как гостю", "оператор увидит"]
      }
    }
  ]
}
